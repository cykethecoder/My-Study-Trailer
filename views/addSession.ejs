<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Study Session</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/styles.css">
</head>

<body>

    <%- include("partials/header") %>

    <div class="container mt-5 page-box">

        <h1>Add Study Session</h1>

        <form action="/addSession" method="POST">

    <div class="mb-3">
        <label class="form-label">Subject:</label>

        <!-- Dropdown list showing modules added in the Modules section -->
        <select name="subject" class="form-control" required>

            <option value="">-- Select a Module --</option>

            <% for (let i = 0; i < modules.length; i++) { %>

                <option value="<%= modules[i].moduleCode %> <%= modules[i].moduleName %>">
                    <%= modules[i].moduleCode %> - <%= modules[i].moduleName %>
                </option>

            <% } %>

        </select>
    </div>

            <div class="mb-3">
                <label class="form-label">Date:</label>
                <input type="date" name="date" class="form-control" required>
            </div>

            <div class="mb-3">
                <label class="form-label">Duration (In Hours):</label>
                <input type="number" name="duration" class="form-control" 
                placeholder= "Example: 3" required
                min= "0.25"
                step= "0.25"
                oninput="this.value =Math.abs(this.value)"> <!-- During user input, system will convert the user
                input to absolute value-->
            
            </div>

            <div class="mb-3">
                <label class="form-label">Focus Rating:</label>
                <select name="focusRating" class="form-control" required>
                    <option value="1">1 - Very Low</option>
                    <option value="2">2 - Low</option>
                    <option value="3">3 - Average</option>
                    <option value="4">4 - Good</option>
                    <option value="5">5 - Excellent</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">Reflection:</label>
                <textarea name="reflection" class="form-control"
                placeholder="Write what you have completed, learnt, improved on, or struggled with during this study session..." required></textarea>
            </div>

            <div class="mb-3">
                <label class="form-label">Study Session Image Link:</label>

                <input type="text"
                       name="imageUrl"
                       class="form-control"
                       placeholder="Example: /imgs/study1.jpg or https://example.com/image.jpg">
            </div>

            <div class="mb-3">
                <label class="form-label">Year &amp; Semester:</label>
                <select name="yearSemester" class="form-control" required>
                    <option value="" disabled>Select year &amp; semester</option>
                    <%
                        const semOptions = [
                            "Year 1 Semester 1", "Year 1 Semester 2",
                            "Year 2 Semester 1", "Year 2 Semester 2",
                            "Year 3 Semester 1", "Year 3 Semester 2"
                        ];
            // forEach loop goes through every semester option
            // one by one dynamically
            //
            // 'opt' represents the current semester option
            // currently being processed in the loop
            //
            // Example:
            // First loop  -> opt = "Year 1 Semester 1"
            // Second loop -> opt = "Year 1 Semester 2"
                        semOptions.forEach(function(opt) {
                            const sel = userProfile && userProfile.yearSemester === opt ? 'selected' : '';
                    %>
                        <option value="<%= opt %>" <%= sel %>><%= opt %></option>
                    <% }); %>
                </select>
            </div>

            <button type="submit" class="btn btn-success">Add Session</button>
            <a href="/sessions" class="btn btn-secondary">Cancel</a>

        </form>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>