<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Module</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/styles.css">
</head>

<body>

    <%- include("partials/header") %>

    <div class="container mt-5 page-box">

        <h1>Add Module</h1>

        <form action="/addModule" method="POST">

            <div class="mb-3">
                <label class="form-label">Module Code:</label>
                <input type="text" name="moduleCode" class="form-control"
                       placeholder="Example: C237" required>
            </div>

            <div class="mb-3">
                <label class="form-label">Module Name:</label>
                <input type="text" name="moduleName" class="form-control"
                       placeholder="Example: Software Application Development" required>
            </div>

            <div class="mb-3">
                <label class="form-label">Current Grade:</label>

                <select name="currentGrade" class="form-control" required>
                    <option value="">-- Select Current Grade --</option>
                    <option value="No Grade Yet">No Grade Yet</option>
                    <option value="DIST">DIST</option>
                    <option value="A">A</option>
                    <option value="B+">B+</option>
                    <option value="B">B</option>
                    <option value="C+">C+</option>
                    <option value="C">C</option>
                    <option value="D">D</option>
                    <option value="NGP">Non-Gradable-Pass</option>
                </select>
            </div>
            <!-- Semester dropdown automatically pre-selects -->
            <!-- the user's current semester based on -->
            <!-- personalised profile information -->
            <div class="mb-3">
                <label class="form-label">Year &amp; Semester:</label>
                <select name="yearSemester" class="form-control" required>
                    <option value="" disabled>Select year &amp; semester</option>
                    <%
                        const semOptions = [
                            "Year 1 Semester 1", "Year 1 Semester 2",
                            "Year 2 Semester 1", "Year 2 Semester 2",
                            "Year 3 Semester 1", "Year 3 Semester 2"
                        ];
                        // Loop through semester options dynamically
                        // Automatically select the semester
                        // matching the user's saved profile
            // forEach loop goes through every semester option
            // one by one dynamically
            //
            // 'opt' represents the current semester option
            // currently being processed in the loop
            //
            // Example:
            // First loop  -> opt = "Year 1 Semester 1"
            // Second loop -> opt = "Year 1 Semester 2"                        
                        semOptions.forEach(function(opt) {
                            const sel = userProfile && userProfile.yearSemester === opt ? 'selected' : '';
                    %>
                        <option value="<%= opt %>" <%= sel %>><%= opt %></option>
                    <% }); %>
                </select>
            </div>

            <button type="submit" class="btn btn-success">Add Module</button>
            <a href="/modules" class="btn btn-secondary">Cancel</a>

        </form>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>