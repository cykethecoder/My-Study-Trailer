<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Study Goal</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/styles.css">
</head>

<body>

    <%- include("partials/header") %>

    <div class="container mt-5 page-box">

        <h1>Add Study Goal</h1>

        <form action="/addGoal" method="POST">

            <div class="mb-3">
                <label class="form-label">Goal Title:</label>
                <input type="text" name="goalTitle" class="form-control"
                       placeholder="Example: Revise EJS CRUD before CA1"
                       required>
            </div>

            <div class="mb-3">
                <label class="form-label">Related Module:</label>

                <select name="relatedModule" class="form-control" required>
                    <option value="">-- Select a Module --</option>

                    <% for (let i = 0; i < modules.length; i++) { %>
                        <option value="<%= modules[i].moduleCode %> <%= modules[i].moduleName %>">
                            <%= modules[i].moduleCode %> - <%= modules[i].moduleName %>
                        </option>
                    <% } %>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">Target Date:</label>
                <input type="date" name="targetDate" class="form-control" required>
            </div>

            <div class="mb-3">
                <label class="form-label">Status:</label>

                <select name="status" class="form-control" required>
                    <option value="Not Started">Not Started</option>
                    <option value="In Progress">In Progress</option>
                    <option value="Completed">Completed</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">Goal Description / Notes:</label>

                <textarea name="description"
                        class="form-control"
                        placeholder="Write more details about this goal..."
                        required></textarea>
            </div>
            <!-- Semester selection dropdown -->
            <!-- Automatically pre-selects the user's current semester -->
            <!-- based on the personalised profile information entered -->
            <!-- from the 'Get to Know You' feature -->

            <div class="mb-3">
                <label class="form-label">Year &amp; Semester:</label>
                <select name="yearSemester" class="form-control" required>
                    <option value="" disabled>Select year &amp; semester</option>
                    <%
                        const semOptions = [
                            "Year 1 Semester 1", "Year 1 Semester 2",
                            "Year 2 Semester 1", "Year 2 Semester 2",
                            "Year 3 Semester 1", "Year 3 Semester 2"
                        ];
            // forEach loop goes through every semester option
            // one by one dynamically
            //
            // 'opt' represents the current semester option
            // currently being processed in the loop
            //
            // Example:
            // First loop  -> opt = "Year 1 Semester 1"
            // Second loop -> opt = "Year 1 Semester 2"
                        semOptions.forEach(function(opt) {
                            const sel = userProfile && userProfile.yearSemester === opt ? 'selected' : '';
                    %>
                        <option value="<%= opt %>" <%= sel %>><%= opt %></option>
                    <% }); %>
                </select>
            </div>
            
            <button type="submit" class="btn btn-success">Add Goal</button>
            <a href="/goals" class="btn btn-secondary">Cancel</a>

        </form>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>