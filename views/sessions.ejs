<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Study Sessions</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css">
</head>

<body>
    <%- include("partials/header") %>
    <div class="container mt-5 page-box">
        <h1>Study Sessions</h1>

        <!-- Search and filter form -->
        <form action="/searchSessions" method="GET" class="mb-4">
            <div class="row">
                <div class="col-md-3">
                    <label class="form-label">Module Code:</label>
                    <input type="text"
                        name="moduleCode"
                        class="form-control"
                        placeholder="Example: C237">
                </div>
                <div class="col-md-3">
                    <label class="form-label">Date:</label>
                    <input type="date"
                        name="date"
                        class="form-control">
                </div>

                <div class="col-md-3">
                    <label class="form-label">Duration:</label>
                    <input type="number"
                        name="duration"
                        class="form-control"
                        placeholder="Example: 2">
                </div>

                <div class="col-md-3">
                    <label class="form-label">Focus Rating:</label>
                    <select name="focusRating" class="form-control">
                        <option value="">All Ratings</option>
                        <option value="1">1 - Very Low</option>
                        <option value="2">2 - Low</option>
                        <option value="3">3 - Average</option>
                        <option value="4">4 - Good</option>
                        <option value="5">5 - Excellent</option>
                    </select>
                </div>

            </div>

            <button type="submit" class="btn btn-primary mt-3">Search / Filter</button>
            <a href="/sessions" class="btn btn-secondary mt-3">Reset</a>

        </form>
        
    <!-- Right-aligned button above Actions column -->
    <div class="d-flex justify-content-end mb-2">

        <a href="/addSession" class="btn btn-success">New Session</a>


    </div>
        <% if (sessions.length === 0) { %>

            <p>No study sessions added yet.</p>

        <% } else {
            // Group sessions by yearSemester
            const grouped = {};
            sessions.forEach(function(session) {
                const key = session.yearSemester || 'Unknown';
                if (!grouped[key]) grouped[key] = [];
                grouped[key].push(session);
            });
            const semesters = Object.keys(grouped).sort();
        %>

            <% semesters.forEach(function(sem) {
                const isCurrent = userProfile && userProfile.yearSemester === sem;
            %>

            <div class="card shadow-sm mb-4 <%= isCurrent ? 'border-primary' : '' %>">
                <div class="card-header d-flex justify-content-between align-items-center
                    <%= isCurrent ? 'bg-primary text-white' : 'bg-light' %>">
                    <span class="fw-semibold"><%= sem %></span>
                    <% if (isCurrent) { %>
                        <span class="badge bg-light text-primary">Current Semester</span>
                    <% } %>
                </div>
                <div class="card-body p-0">
                    <table class="table table-bordered table-striped table-light mb-0">
                        <thead>
                            <tr>
                                <th>Subject</th>
                                <th>Date</th>
                                <th>Duration</th>
                                <th>Focus Rating</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% grouped[sem].forEach(function(session) { %>
                            <tr>
                                <td><%= session.subject %></td>
                                <td><%= session.date %></td>
                                <td><%= session.duration %> hour(s)</td>
                                <td><%= session.focusRating %>/5 - <%= getFocusLabel(session.focusRating) %></td>
                                <td>
                                    <a href="/details/<%= session.index %>" class="btn btn-info btn-sm">
                                        <i class="fa-solid fa-circle-info"></i>
                                    </a>
                                    <a href="/editSessions/<%= session.index %>" class="btn btn-warning btn-sm">
                                        <i class="fa-regular fa-pen-to-square"></i>
                                    </a>
                                    <a href="/deleteSession/<%= session.index %>" class="btn btn-danger btn-sm"
                                        onclick="return confirm('Are you sure you wanna delete this study session?')">
                                        <i class="fa-regular fa-trash-can"></i>
                                    </a>
                                </td>
                            </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </div>

            <% }); %>

        <% } %>

    </div>
    
</body>
</html>   