<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Modules</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css">
</head>

<body>

    <%- include("partials/header") %>

    <div class="container mt-5 page-box">

        <h1>Modules</h1>

        <!-- Search Module -->
        <form action="/searchModules" method="GET" class="mb-4">

            <div class="row">
                <div class="col-md-6">
                    <div class="d-flex gap-2 align-items-center">
                        <div class="position-relative flex-grow-1">
                            <input type="text"
                                id="moduleCodeInput"
                                name="moduleCode"
                                class="form-control pe-4"
                                placeholder="Search by module code or name...">
                            <button type="button" id="clearSearch"
                                class="btn-close position-absolute top-50 end-0 translate-middle-y me-2"
                                style="display:none; font-size:0.65rem;"
                                aria-label="Clear"></button>
                        </div>
                        <button type="submit" class="btn btn-primary">Search</button>
                    </div>
                </div>
            </div>

        </form>

        <div class="d-flex justify-content-end mb-2">
            <a href="/addModule" class="btn btn-success">
                Add Module
            </a>
        </div>

        <% if (modules.length === 0) { %>

            <p>No modules added yet.</p>

        <% } else {
            const grouped = {};
            modules.forEach(function(mod) {
                const key = mod.yearSemester || 'Unknown';
                if (!grouped[key]) grouped[key] = [];
                grouped[key].push(mod);
            });
            const semesters = Object.keys(grouped).sort();
        %>

            <% semesters.forEach(function(sem) {
                const isCurrent = userProfile && userProfile.yearSemester === sem;
            %>

            <div class="card shadow-sm mb-4 <%= isCurrent ? 'border-primary' : '' %>">
                <div class="card-header d-flex justify-content-between align-items-center
                    <%= isCurrent ? 'bg-primary text-white' : 'bg-light' %>">
                    <span class="fw-semibold"><%= sem %></span>
                    <% if (isCurrent) { %>
                        <span class="badge bg-light text-primary">Current Semester</span>
                    <% } %>
                </div>
                <div class="card-body p-0">
                    <table class="table table-bordered table-striped table-light mb-0">
                        <thead>
                            <tr>
                                <th>Module Code</th>
                                <th>Module Name</th>
                                <th>Current Grade</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% grouped[sem].forEach(function(mod) { %>
                            <tr>
                                <td><%= mod.moduleCode %></td>
                                <td><%= mod.moduleName %></td>
                                <td><%= mod.currentGrade %></td>
                                <td>
                                    <a href="/editModule/<%= mod.index %>" class="btn btn-warning btn-sm">
                                        <i class="fa-regular fa-pen-to-square"></i>
                                    </a>
                                    <a href="/deleteModule/<%= mod.index %>" class="btn btn-danger btn-sm"
                                       onclick="return confirm('Are you sure you want to delete this module?')">
                                        <i class="fa-regular fa-trash-can"></i>
                                    </a>
                                </td>
                            </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </div>

            <% }); %>

        <% } %>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        const input = document.getElementById('moduleCodeInput');
        const clearBtn = document.getElementById('clearSearch');

        input.addEventListener('input', function () {
            clearBtn.style.display = this.value ? 'block' : 'none';
        });

        clearBtn.addEventListener('click', function () {
            input.value = '';
            clearBtn.style.display = 'none';
            input.focus();
        });
    </script>

</body>
</html>